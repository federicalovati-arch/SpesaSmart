/**
 * This ruleset enforces a private data model for all logged-in users.
 * All user data is stored within subcollections under `/users/{userId}`.
 *
 * Core Philosophy:
 * User data is strictly private and accessible only by the owner. There is no
 * shared or public data between users in the current application logic.
 *
 * Data Structure:
 * - /users/{userId}/{collection}/{docId}: All of a user's data, including
 *   products, supermarkets, shopping lists, categories, and receipts, are
 *   stored in subcollections under their unique user ID.
 *
 * Key Security Decisions:
 * - Strict User Ownership: All read and write operations on any user-related
 *   document are restricted to the authenticated user whose UID matches the
 *   {userId} in the document path.
 * - No User Enumeration: The top-level `/users` collection cannot be listed,
 *   protecting the privacy of the user base.
 * - Simplified Rules: Since all data is private, the rules are simplified to
 *   enforce ownership based on the path, which is secure and efficient.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Verifies that the currently authenticated user's UID matches the provided userId.
     * This is the cornerstone of the user-ownership model.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // --------------------------------------------------------------------
    // Global Collections (currently unused by logged-in user flow)
    // These are read-only for any signed-in user. Writes are disabled.
    // --------------------------------------------------------------------

    match /supermarkets/{supermarketId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    match /products/{productId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    match /productPrices/{productPriceId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    // --------------------------------------------------------------------
    // User-Specific Data
    // --------------------------------------------------------------------
    
    // Prevent anyone from reading the list of users.
    match /users/{userId} {
      allow read, write: if false;
    }

    // Secure all primary user data subcollections (products, supermarkets, etc.)
    // Only the owner of the data can read or write to it.
    match /users/{userId}/{collection}/{docId}
      where collection in ['products', 'supermarkets', 'categories', 'receipts', 'shoppingLists'] {
        allow read, write: if isOwner(userId);
    }
    
    // Secure the nested shopping list items.
    match /users/{userId}/shoppingLists/{shoppingListId}/shoppingListItems/{shoppingListItemId} {
        allow read, write: if isOwner(userId);
    }
  }
}
