/**
 * This ruleset enforces a private data model for all logged-in users.
 * All user data is stored within subcollections under `/users/{userId}`.
 *
 * Core Philosophy:
 * User data is strictly private and accessible only by the owner. There is no
 * shared or public data between users in the current application logic.
 *
 * Data Structure:
 * - /users/{userId}/{collection}/{docId}: All of a user's data, including
 *   products, supermarkets, shopping lists, categories, and receipts, are
 *   stored in subcollections under their unique user ID.
 *
 * Key Security Decisions:
 * - Strict User Ownership: All read and write operations on any user-related
 *   document are restricted to the authenticated user whose UID matches the
 *   {userId} in the document path.
 * - No User Enumeration: The top-level `/users` collection cannot be listed,
 *   protecting the privacy of the user base.
 * - Simplified Rules: Since all data is private, the rules are simplified to
 *   enforce ownership based on the path, which is secure and efficient.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of the document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Prevent listing of all users, but allow users to access their own user document.
    match /users/{userId} {
      allow get, update, delete: if isOwner(userId);
      allow create: if request.auth.uid == userId;
      allow list: if false;
    }

    // Secure all primary user data subcollections.
    // Only the owner of the data can read or write to it.
    match /users/{userId}/products/{productId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/supermarkets/{supermarketId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/categories/{categoryId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/receipts/{receiptId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/shoppingLists/{shoppingListId} {
        allow read, write: if isOwner(userId);
    
        // Secure the nested shopping list items.
        match /shoppingListItems/{shoppingListItemId} {
            allow read, write: if isOwner(userId);
        }
    }
  }
}
